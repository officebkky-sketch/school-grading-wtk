{
  "name": "school-grading-wtk",
  "productName": "ระบบวัดผล ปพ.5-6 ดิจิทัล - วัดท่าควาย",
  "private": true,
  "version": "1.0.1",
  "description": "ระบบวัดผลและประเมินผล ปพ.5-6 ดิจิทัล (สพฐ.) โรงเรียนวัดท่าควาย",
  "author": "โรงเรียนวัดท่าควาย",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:koko": "tsc -b && vite build --mode koko",
    "preview": "vite preview",
    "start": "electron .",
    "electron:dist": "tsc -b && vite build && electron-builder --win"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@types/qrcode": "^1.5.6",
    "dexie": "^4.4.5",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.14.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "vite": "^8.0.10"
  },
  "build": {
    "appId": "th.go.obec.wtk.schoolgrading",
    "productName": "ระบบวัดผล ปพ.5-6 ดิจิทัล - โรงเรียนวัดท่าควาย",
    "electronVersion": "41.1.0",
    "publish": [
      {
        "provider": "github",
        "owner": "officebkky-sketch",
        "repo": "school-grading-wtk"
      }
    ],
    "directories": {
      "output": "dist_installer"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ระบบวัดผล ปพ.5-6 ดิจิทัล โรงเรียนวัดท่าควาย"
    }
  }
}
